{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "brandOrange": "#FF6600",
    "accentOrange": "#FF7A2E",
    "accentOrangeLit": "#FF9354",
    "accentOrangeSoft": "#FFB07A",
    "accentOrangeDeep": "#C2410C",
    "accentOrangeInk": "#7C2D12",

    "ground": "#0B0C0E",
    "panel": "#121315",
    "elevated": "#191B1D",
    "elevated2": "#212325",
    "border": "#262829",
    "borderSoft": "#1C1E20",

    "text": "#F5F6F8",
    "textFaint": "#A0A3A8",
    "textDim": "#8E9297",
    "textGhost": "#3A3D3F",

    "success": "#5DD89B",
    "warning": "#E8C33A",
    "error": "#F7768E",
    "teal": "#5EEAD4",

    "lightGround": "#FFFFFF",
    "lightPanel": "#FAFAFA",
    "lightElevated": "#F2F2F4",
    "lightElevated2": "#E9E9EC",
    "lightBorder": "#D9D9DE",
    "lightBorderSoft": "#EDEDF0",
    "lightText": "#0B0C0E",
    "lightTextDim": "#6B6E73",
    "lightTextFaint": "#8E9297",
    "lightTextGhost": "#C4C6CA",
    "lightSuccess": "#1B7F4F",
    "lightWarning": "#8A6D0B",
    "lightError": "#C2334C",
    "lightTeal": "#0F766E"
  },
  "theme": {
    "primary": { "dark": "brandOrange", "light": "brandOrange" },
    "accent": { "dark": "accentOrange", "light": "accentOrangeDeep" },
    "secondary": { "dark": "teal", "light": "lightTeal" },
    "info": { "dark": "accentOrangeSoft", "light": "accentOrangeDeep" },

    "error": { "dark": "error", "light": "lightError" },
    "warning": { "dark": "warning", "light": "lightWarning" },
    "success": { "dark": "success", "light": "lightSuccess" },

    "text": { "dark": "text", "light": "lightText" },
    "textMuted": { "dark": "textDim", "light": "lightTextDim" },

    "selectedListItemText": { "dark": "ground", "light": "lightGround" },

    "background": { "dark": "ground", "light": "lightGround" },
    "backgroundPanel": { "dark": "panel", "light": "lightPanel" },
    "backgroundElement": { "dark": "elevated", "light": "lightElevated" },
    "backgroundMenu": { "dark": "elevated2", "light": "lightElevated2" },

    "border": { "dark": "border", "light": "lightBorder" },
    "borderActive": { "dark": "accentOrange", "light": "accentOrangeDeep" },
    "borderSubtle": { "dark": "borderSoft", "light": "lightBorderSoft" },

    "diffAdded": { "dark": "success", "light": "lightSuccess" },
    "diffRemoved": { "dark": "error", "light": "lightError" },
    "diffContext": { "dark": "textDim", "light": "lightTextDim" },
    "diffHunkHeader": { "dark": "textFaint", "light": "lightTextFaint" },
    "diffHighlightAdded": { "dark": "#8DE8B8", "light": "#12603B" },
    "diffHighlightRemoved": { "dark": "#FF9BAC", "light": "#A62740" },
    "diffAddedBg": { "dark": "#0F2018", "light": "#E4F5EB" },
    "diffRemovedBg": { "dark": "#241318", "light": "#FBE4E9" },
    "diffContextBg": { "dark": "panel", "light": "lightPanel" },
    "diffLineNumber": { "dark": "textGhost", "light": "lightTextGhost" },
    "diffAddedLineNumberBg": { "dark": "#0C1913", "light": "#D6EDDF" },
    "diffRemovedLineNumberBg": { "dark": "#1D0F13", "light": "#F6D8DF" },

    "markdownText": { "dark": "text", "light": "lightText" },
    "markdownHeading": { "dark": "brandOrange", "light": "accentOrangeDeep" },
    "markdownLink": { "dark": "accentOrange", "light": "accentOrangeDeep" },
    "markdownLinkText": { "dark": "accentOrangeSoft", "light": "accentOrangeDeep" },
    "markdownCode": { "dark": "accentOrangeSoft", "light": "accentOrangeDeep" },
    "markdownBlockQuote": { "dark": "textFaint", "light": "lightTextFaint" },
    "markdownEmph": { "dark": "accentOrangeLit", "light": "accentOrangeDeep" },
    "markdownStrong": { "dark": "accentOrange", "light": "accentOrangeDeep" },
    "markdownHorizontalRule": { "dark": "borderSoft", "light": "lightBorderSoft" },
    "markdownListItem": { "dark": "accentOrange", "light": "accentOrangeDeep" },
    "markdownListEnumeration": { "dark": "accentOrangeLit", "light": "accentOrangeDeep" },
    "markdownImage": { "dark": "accentOrange", "light": "accentOrangeDeep" },
    "markdownImageText": { "dark": "textFaint", "light": "lightTextFaint" },
    "markdownCodeBlock": { "dark": "text", "light": "lightText" },

    "syntaxComment": { "dark": "textGhost", "light": "lightTextGhost" },
    "syntaxKeyword": { "dark": "accentOrange", "light": "accentOrangeDeep" },
    "syntaxFunction": { "dark": "accentOrangeLit", "light": "accentOrangeInk" },
    "syntaxVariable": { "dark": "text", "light": "lightText" },
    "syntaxString": { "dark": "success", "light": "lightSuccess" },
    "syntaxNumber": { "dark": "accentOrangeSoft", "light": "accentOrangeDeep" },
    "syntaxType": { "dark": "teal", "light": "lightTeal" },
    "syntaxOperator": { "dark": "textFaint", "light": "lightTextFaint" },
    "syntaxPunctuation": { "dark": "textDim", "light": "lightTextDim" }
  }
}
