{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "elliotOrange": "#FF6600",
    "elliotOrangeLit": "#FF9354",
    "elliotOrangeSoft": "#FFB07A",
    "elliotOrangeDeep": "#D4551A",

    "darkGround": "#0a0a0a",
    "darkPanel": "#0d0d0e",
    "darkElement": "#161618",
    "darkShadow": "#2a2a2c",
    "darkHairline": "#1a1a1c",
    "darkRule": "#232325",
    "darkTextFaint": "#5a5a60",
    "darkTextMuted": "#8b8b92",
    "darkTextLabel": "#9a9aa0",
    "darkText": "#d6d6d8",

    "lightGround": "#ffffff",
    "lightPanel": "#fcfcfc",
    "lightElement": "#f4f4f6",
    "lightHairline": "#efeff1",
    "lightRule": "#e6e6ea",
    "lightTextFaint": "#a4a4ac",
    "lightTextMuted": "#6b6b72",
    "lightText": "#1a1a1c",

    "red": "#e06c75",
    "redLight": "#c8383d",
    "yellow": "#e5c07b",
    "yellowLight": "#a8791f",
    "green": "#7fd88f",
    "greenLight": "#2f7d45",
    "violet": "#b48ce0",
    "violetLight": "#7b4fb8",
    "blue": "#7fb2e5",
    "blueLight": "#2f5f96"
  },
  "theme": {
    "primary": { "dark": "elliotOrange", "light": "elliotOrange" },
    "secondary": { "dark": "violet", "light": "violetLight" },
    "accent": { "dark": "elliotOrangeLit", "light": "elliotOrangeDeep" },

    "error": { "dark": "red", "light": "redLight" },
    "warning": { "dark": "yellow", "light": "yellowLight" },
    "success": { "dark": "green", "light": "greenLight" },
    "info": { "dark": "blue", "light": "blueLight" },

    "text": { "dark": "darkText", "light": "lightText" },
    "textMuted": { "dark": "darkTextMuted", "light": "lightTextMuted" },

    "background": { "dark": "darkGround", "light": "lightGround" },
    "backgroundPanel": { "dark": "darkPanel", "light": "lightPanel" },
    "backgroundElement": { "dark": "darkElement", "light": "lightElement" },

    "border": { "dark": "darkRule", "light": "lightRule" },
    "borderActive": { "dark": "elliotOrange", "light": "elliotOrange" },
    "borderSubtle": { "dark": "darkHairline", "light": "lightHairline" },

    "diffAdded": { "dark": "green", "light": "greenLight" },
    "diffRemoved": { "dark": "red", "light": "redLight" },
    "diffContext": { "dark": "darkTextMuted", "light": "lightTextMuted" },
    "diffHunkHeader": { "dark": "darkTextFaint", "light": "lightTextFaint" },
    "diffHighlightAdded": { "dark": "#a6e3b8", "light": "#1f6a35" },
    "diffHighlightRemoved": { "dark": "#f0929a", "light": "#b02b30" },
    "diffAddedBg": { "dark": "#12251a", "light": "#e3f3e8" },
    "diffRemovedBg": { "dark": "#2a1417", "light": "#fae4e6" },
    "diffContextBg": { "dark": "darkPanel", "light": "lightPanel" },
    "diffLineNumber": { "dark": "darkShadow", "light": "lightRule" },
    "diffAddedLineNumberBg": { "dark": "#0f1e15", "light": "#d3e9da" },
    "diffRemovedLineNumberBg": { "dark": "#221013", "light": "#f0d5d8" },

    "markdownText": { "dark": "darkText", "light": "lightText" },
    "markdownHeading": { "dark": "darkText", "light": "lightText" },
    "markdownLink": { "dark": "elliotOrange", "light": "elliotOrangeDeep" },
    "markdownLinkText": { "dark": "darkTextMuted", "light": "lightTextMuted" },
    "markdownCode": { "dark": "darkTextLabel", "light": "lightTextMuted" },
    "markdownBlockQuote": { "dark": "darkTextMuted", "light": "lightTextMuted" },
    "markdownEmph": { "dark": "darkText", "light": "lightText" },
    "markdownStrong": { "dark": "darkText", "light": "lightText" },
    "markdownHorizontalRule": { "dark": "darkHairline", "light": "lightHairline" },
    "markdownListItem": { "dark": "darkTextMuted", "light": "lightTextMuted" },
    "markdownListEnumeration": { "dark": "darkTextFaint", "light": "lightTextFaint" },
    "markdownImage": { "dark": "elliotOrange", "light": "elliotOrangeDeep" },
    "markdownImageText": { "dark": "darkTextMuted", "light": "lightTextMuted" },
    "markdownCodeBlock": { "dark": "darkText", "light": "lightText" },

    "syntaxComment": { "dark": "darkTextFaint", "light": "lightTextFaint" },
    "syntaxKeyword": { "dark": "elliotOrangeSoft", "light": "elliotOrangeDeep" },
    "syntaxFunction": { "dark": "darkText", "light": "lightText" },
    "syntaxVariable": { "dark": "darkText", "light": "lightText" },
    "syntaxString": { "dark": "green", "light": "greenLight" },
    "syntaxNumber": { "dark": "elliotOrangeSoft", "light": "elliotOrangeDeep" },
    "syntaxType": { "dark": "darkTextLabel", "light": "lightTextMuted" },
    "syntaxOperator": { "dark": "darkTextMuted", "light": "lightTextMuted" },
    "syntaxPunctuation": { "dark": "darkTextFaint", "light": "lightTextFaint" }
  }
}
